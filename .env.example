SERVICE_ENV=dev

ORDER_SERVICE=order_service
ORDER_SERVICE_VERSION=v1.0.0
ORDER_SERVICE_HTTP_PORT=11000
ORDER_SERVICE_HTTP_HOST=0.0.0.0

INVENTORY_SERVICE=inventory_service
INVENTORY_SERVICE_HTTP_PORT=11001
INVENTORY_SERVICE_HTTP_HOST=0.0.0.0
INVENTORY_SERVICE_VERSION=v1.0.0

# PostgreSQL Config
DB_HOST=localhost
DB_PORT=10001
DB_USERNAME=test
DB_PASSWORD=test

# Databases
DB_ORDER_DATABASE=orders_db
DB_INVENTORY_DATABASE=inventory_db

INVENTORY_SERVICE_BASE_URL=http://localhost:11001

# Config Otel
APM_ENABLE=true
APM_INSECURE_MODE=true
APM_EXPORTER_ENDPOINT=localhost:4318
APM_API_KEY=your_ingest_api_key
